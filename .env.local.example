# Local development only. Never commit real production credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payrollph
DEMO_MODE=true

# Production security controls
# Generate separate strong random values per environment.
WORKER_TOKEN=
# Dedicated worker activation and central scheduler activation are separate.
# WORKER_ENABLED also permits processing queued payroll jobs: leave false
# until payroll queue use is independently cleared for this environment.
WORKER_ENABLED=false
# Default-off release gate: without exactly "true" neither worker nor
# POST /api/jobs/tick starts scheduled retention, HR, salary, automation,
# statutory or notification work. Enable only on isolated staging first.
CENTRAL_SCHEDULER_ENABLED=false
# Separate 32+ byte monitor-only secret for GET /api/jobs/status; never reuse WORKER_TOKEN.
SCHEDULER_MONITOR_TOKEN=
# Strictly default-OFF sanitized OpenTelemetry Logs. Never forward raw errors, PII,
# credentials, bank accounts or Philippine government identifiers.
SAFE_OTEL_ERRORS_ENABLED=false
# Operator-approved HTTPS collector ending /v1/logs, with independent retention review.
OTLP_LOGS_ENDPOINT=
# Private 32+ byte token, never reuse payroll, worker or encryption secrets.
OTLP_LOGS_BEARER_TOKEN=
# Vercel scheduled GET /api/jobs/cron uses a DIFFERENT 32+ byte secret.
# Cron is not an approval to enable scheduled work; see CENTRAL_SCHEDULER_ENABLED.
CRON_SECRET=
# Self-hosted reverse proxies only: number (1-10) of trusted hops appending
# X-Forwarded-For. Restrict direct access to those proxies. Leave empty on Vercel.
TRUSTED_PROXY_HOPS=
READINESS_TOKEN=
SETUP_TOKEN=
TOTP_ENCRYPTION_KEY=
# 32+ byte key used only for enterprise OIDC client secrets and PKCE verifier material.
ENTERPRISE_IDENTITY_ENCRYPTION_KEY=
# 32 bytes as 64 hex characters or base64. Keep outside the database.
BANK_DATA_ENCRYPTION_KEY=
# REQUIRED to save employee/contractor TIN, SSS, PhilHealth and Pag-IBIG numbers,
# employee imports and registration changes. Without it those writes fail closed;
# there is no fallback to TOTP_ENCRYPTION_KEY. 32 bytes as 64 hex characters or
# base64 (generate with: openssl rand -hex 32). Keep outside the database.
PII_ENCRYPTION_KEY=
# Only while rotating: the previous PII key, so existing values stay readable.
PII_ENCRYPTION_KEY_PREVIOUS=
# Rotation only: the previous bank-data / TOTP keys, so existing values stay readable
# while you re-encrypt. Remove them once zero old-key rows remain.
BANK_DATA_ENCRYPTION_KEY_PREVIOUS=
TOTP_ENCRYPTION_KEY_PREVIOUS=
# Private document uploads (with DOCUMENT_UPLOADS_ENABLED): an S3-compatible bucket.
# There is no fallback storage: uploads fail with "not configured" if any of these
# is missing. HTTPS only (plain http is allowed only for a localhost emulator
# outside production). The bucket must be private.
DOCUMENT_OBJECT_STORAGE_ENDPOINT=
DOCUMENT_OBJECT_STORAGE_BUCKET=
DOCUMENT_OBJECT_STORAGE_REGION=
DOCUMENT_OBJECT_STORAGE_ACCESS_KEY_ID=
DOCUMENT_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# At least 32 characters. Signs the public intake proof issued by /api/intake-challenge;
# the proof fails closed (PUBLIC_INTAKE_PROOF_SECRET_REQUIRED) without it.
# See docs/security/public-intake-proof-rollout.md
PUBLIC_INTAKE_PROOF_SECRET=
# At least 32 characters. Peppers the device hash for the opt-in web-bundy evidence
# capture (POST /api/web-bundy/evidence throws without it).
PUNCH_DEVICE_HASH_KEY=
# Monitoring token. /api/health falls back to WORKER_TOKEN; /api/readiness/billing
# returns 404 without HEALTH_TOKEN. Sent by the monitor as x-health-token.
HEALTH_TOKEN=
# Bearer secret for the HCM work-item SLA scheduler (POST /api/hcm/work-items/escalate
# returns 503 without it). See docs/HCM_WORK_ITEM_SLA.md
HCM_SLA_CRON_SECRET=
PUBLIC_DEMO_HOSTS=
TRUSTED_APP_ORIGINS=
REQUIRE_PRIVILEGED_MFA=true
PRIVILEGED_MFA_MAX_AGE_HOURS=12
BIOMETRIC_INGEST_SECRET=

# Opt-in GPS clock-in pilot: BOTH values required; no raw employee GPS retained.
# DBA must apply drizzle/0111_wfm_geofenced_web_bundy.sql before ENABLING the GPS pilot.
# Requires employer privacy notice, DPO review, worksite setup and a fair HR exception path.
WFM_GEOFENCE_PILOT_ENABLED=false
WFM_GEOFENCE_PILOT_ORG_IDS=
# Production uploads are opt-in. Leave false until malware scanning is configured and verified.
DOCUMENT_UPLOADS_ENABLED=false
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
MALWARE_SCAN_TIMEOUT_MS=8000

# Payments
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_DISBURSEMENTS_ENABLED=false
# Wallet to pay from (Dashboard -> Money Movement -> Wallets). Its account is the
# transfer source_account, and its available balance is checked before a payout.
PAYMONGO_WALLET_ID=


# Transactional email
# Configure exactly one delivery provider. Resend supports verified delivery
# outcomes through POST /api/webhooks/resend when RESEND_WEBHOOK_SECRET is set.
MAIL_FROM=Linaw <no-reply@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
SMTP_URL=

# Optional search engine ownership verification. Configure in deployment secrets.
# Never commit real verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional internal SEO/marketing aggregate reporting.
# Comma-separated authenticated user emails allowed to call /api/marketing/leads.
# Leave empty to keep the report disabled.
MARKETING_REPORT_EMAILS=

# Encrypts provider-specific integration credentials such as Slack bot tokens.
# Required before a provider connector can be saved. Use a dedicated 32-byte
# random key encoded as 64 hex characters or base64; do not reuse bank/TOTP keys.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

# Server-only rollout gate: disables the ENTIRE language drafting lane by default,
# including the approved-template fallback. Keep false until independent review,
# isolated staging acceptance and authorized rollout. Does not disable manual Studio.
AUTOMATION_LANGUAGE_STUDIO_ENABLED=false

# Optional, tenant-admin-only natural-language Automation Studio drafting.
# Without a key, only strict matches to approved starter patterns are supported.
# Requests are sent to the configured model service; use generalized workflow
# descriptions without employee PII, compensation, bank or health details.
# Keep this key in environment secrets only. Never expose it via NEXT_PUBLIC_*.
# Must be explicitly enabled even if a key is configured for another feature.
OPENAI_AUTOMATION_DRAFT_ENABLED=false
# Additional release locks. Do not flip until an actual DPO/controller review:
# per-organization recorded opt-in, signed DPA, verified contractual zero
# retention and notice. These env flags are *not* themselves legal evidence.
OPENAI_AUTOMATION_DPA_CONFIRMED=false
OPENAI_AUTOMATION_ZERO_RETENTION_CONFIRMED=false
OPENAI_AUTOMATION_NOTICE_CONFIRMED=false
OPENAI_AUTOMATION_APPROVED_ORG_IDS=

OPENAI_API_KEY=
OPENAI_AUTOMATION_DRAFT_MODEL=gpt-4.1-mini

# Optional small-employer pilot UI only; never changes server-side RBAC.
# Both flags required, and only exact organization IDs are affected.
PILOT_FOCUS_NAV_ENABLED=false
PILOT_FOCUS_ORG_IDS=

# Disabled unless an operator configures explicitly approved annual days
# per organization ID and leave type; this is a temporary pilot gate until
# the versioned, DBA-backed convertible-leave policy has been approved.
# Example: {"12":{"vacation leave":5,"service incentive leave":5}}
# Do not enable without employee leave policy and reviewer acceptance.
# Separately configured only after an employer-specific Philippine payroll/tax
# review signs off the actual exemption/withholding classification.
# An approved conversion-days cap alone never authorizes monetization.
LEAVE_CONVERSION_TAX_REVIEWED_ORG_IDS=
LEAVE_CONVERSION_MAX_DAYS_JSON=

# Local development only. Never commit real production credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payrollph
DEMO_MODE=true

# Production security controls
# Generate separate strong random values per environment.
WORKER_TOKEN=
# Dedicated worker activation and central scheduler activation are separate.
# WORKER_ENABLED also permits processing queued payroll jobs: leave false
# until payroll queue use is independently cleared for this environment.
WORKER_ENABLED=false
# Default-off release gate: without exactly "true" neither worker nor
# POST /api/jobs/tick starts scheduled retention, HR, salary, automation,
# statutory or notification work. Enable only on isolated staging first.
CENTRAL_SCHEDULER_ENABLED=false
# Separate 32+ byte monitor-only secret for GET /api/jobs/status; never reuse WORKER_TOKEN.
SCHEDULER_MONITOR_TOKEN=
# Vercel scheduled GET /api/jobs/cron uses a DIFFERENT 32+ byte secret.
# Cron is not an approval to enable scheduled work; see CENTRAL_SCHEDULER_ENABLED.
CRON_SECRET=
# Self-hosted reverse proxies only: number (1-10) of trusted hops appending
# X-Forwarded-For. Restrict direct access to those proxies. Leave empty on Vercel.
TRUSTED_PROXY_HOPS=
READINESS_TOKEN=
SETUP_TOKEN=
TOTP_ENCRYPTION_KEY=
# 32+ byte key used only for enterprise OIDC client secrets and PKCE verifier material.
ENTERPRISE_IDENTITY_ENCRYPTION_KEY=
# 32 bytes as 64 hex characters or base64. Keep outside the database.
BANK_DATA_ENCRYPTION_KEY=
PUBLIC_DEMO_HOSTS=
TRUSTED_APP_ORIGINS=
REQUIRE_PRIVILEGED_MFA=true
PRIVILEGED_MFA_MAX_AGE_HOURS=12
BIOMETRIC_INGEST_SECRET=
# Production uploads are opt-in. Leave false until malware scanning is configured and verified.
DOCUMENT_UPLOADS_ENABLED=false
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
MALWARE_SCAN_TIMEOUT_MS=8000

# Payments
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_DISBURSEMENTS_ENABLED=false
# Wallet to pay from (Dashboard -> Money Movement -> Wallets). Its account is the
# transfer source_account, and its available balance is checked before a payout.
PAYMONGO_WALLET_ID=


# Transactional email
# Configure exactly one delivery provider. Resend supports verified delivery
# outcomes through POST /api/webhooks/resend when RESEND_WEBHOOK_SECRET is set.
MAIL_FROM=Linaw <no-reply@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
SMTP_URL=

# Optional search engine ownership verification. Configure in deployment secrets.
# Never commit real verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional internal SEO/marketing aggregate reporting.
# Comma-separated authenticated user emails allowed to call /api/marketing/leads.
# Leave empty to keep the report disabled.
MARKETING_REPORT_EMAILS=

# Encrypts provider-specific integration credentials such as Slack bot tokens.
# Required before a provider connector can be saved. Use a dedicated 32-byte
# random key encoded as 64 hex characters or base64; do not reuse bank/TOTP keys.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

# Server-only rollout gate: disables the ENTIRE language drafting lane by default,
# including the approved-template fallback. Keep false until independent review,
# isolated staging acceptance and authorized rollout. Does not disable manual Studio.
AUTOMATION_LANGUAGE_STUDIO_ENABLED=false

# Optional, tenant-admin-only natural-language Automation Studio drafting.
# Without a key, only strict matches to approved starter patterns are supported.
# Requests are sent to the configured model service; use generalized workflow
# descriptions without employee PII, compensation, bank or health details.
# Keep this key in environment secrets only. Never expose it via NEXT_PUBLIC_*.
# Must be explicitly enabled even if a key is configured for another feature.
OPENAI_AUTOMATION_DRAFT_ENABLED=false
OPENAI_API_KEY=
OPENAI_AUTOMATION_DRAFT_MODEL=gpt-4.1-mini

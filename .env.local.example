# Local development only. Never commit real production credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payrollph
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000

# Production security controls
# Generate separate strong random values per environment.
WORKER_TOKEN=
READINESS_TOKEN=
SETUP_TOKEN=
TOTP_ENCRYPTION_KEY=
# 32 bytes as 64 hex characters or base64. Keep outside the database.
BANK_DATA_ENCRYPTION_KEY=
PUBLIC_DEMO_HOSTS=
TRUSTED_APP_ORIGINS=
REQUIRE_PRIVILEGED_MFA=true
PRIVILEGED_MFA_MAX_AGE_HOURS=12
BIOMETRIC_INGEST_SECRET=
# Production uploads are opt-in. Leave false until malware scanning is configured and verified.
DOCUMENT_UPLOADS_ENABLED=false
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
MALWARE_SCAN_TIMEOUT_MS=8000

# Payments
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_DISBURSEMENTS_ENABLED=false


# Transactional email
# Configure exactly one delivery provider. Resend supports verified delivery
# outcomes through POST /api/webhooks/resend when RESEND_WEBHOOK_SECRET is set.
MAIL_FROM=Linaw <no-reply@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
SMTP_URL=
